@model BankAccount

@{
    ViewData["Title"] = "Account Details";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">Account Details: @Model.AccountNumber</h4>
                    <span class="badge @(Model.Status == AccountStatus.ACTIVE ? "bg-success" : "bg-danger")">
                        @Model.Status
                    </span>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-sm-6">
                            <p class="text-muted mb-1">Owner Name</p>
                            <h5>@Model.OwnerName</h5>
                        </div>
                        <div class="col-sm-6 text-sm-end">
                            <p class="text-muted mb-1">Current Balance</p>
                            <h3 class="text-primary">@Model.Balance.ToString("C")</h3>
                        </div>
                    </div>

                    <hr />

                    <div class="row text-center mt-4">
                        <div class="col-md-3 mb-2">
                            <a asp-controller="Transaction" asp-action="Deposit" asp-route-accountNumber="@Model.AccountNumber" 
                               class="btn btn-outline-success w-100 @(Model.Status == AccountStatus.FROZEN ? "disabled" : "")">
                                <i class="bi bi-plus-circle"></i> Deposit
                            </a>
                        </div>
                        <div class="col-md-3 mb-2">
                            <a asp-controller="Transaction" asp-action="Withdraw" asp-route-accountNumber="@Model.AccountNumber" 
                               class="btn btn-outline-danger w-100 @(Model.Status == AccountStatus.FROZEN ? "disabled" : "")">
                                <i class="bi bi-dash-circle"></i> Withdraw
                            </a>
                        </div>
                        <div class="col-md-3 mb-2">
                            <a asp-controller="Transaction" asp-action="Transfer" asp-route-fromAccountNumber="@Model.AccountNumber" 
                               class="btn btn-outline-primary w-100 @(Model.Status == AccountStatus.FROZEN ? "disabled" : "")">
                                <i class="bi bi-arrow-left-right"></i> Transfer
                            </a>
                        </div>
                        <div class="col-md-3 mb-2">
                            <a asp-controller="Transaction" asp-action="History" asp-route-accountNumber="@Model.AccountNumber" 
                               class="btn btn-outline-secondary w-100">
                                <i class="bi bi-clock-history"></i> History
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-light">
                    <div class="d-flex justify-content-between">
                        <small class="text-muted">Created: @Model.CreatedAt.ToString("f")</small>
                        <a asp-action="Index" class="btn btn-sm btn-link text-decoration-none">Back to List</a>
                    </div>
                </div>
            </div>

            @if (Model.Status == AccountStatus.FROZEN)
            {
                <div class="alert alert-warning mt-3" role="alert">
                    <strong>Notice:</strong> This account is currently frozen. No financial transactions can be performed until it is unfrozen.
                </div>
            }
        </div>
    </div>
</div>