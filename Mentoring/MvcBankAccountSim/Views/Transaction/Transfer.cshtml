@model dynamic 

<h2>Transfer Funds</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Transfer" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-3">
                <label name="fromAccountNumber" class="form-label">Source Account Number</label>
                <input name="fromAccountNumber" class="form-control" required />
            </div>

            <div class="mb-3">
                <label name="toAccountNumber" class="form-label">Destination Account Number</label>
                <input name="toAccountNumber" class="form-control" required />
            </div>

            <div class="mb-3">
                <label name="amount" class="form-label">Amount</label>
                <input name="amount" type="number" step="0.01" class="form-control" required />
            </div>

            <button type="submit" class="btn btn-primary">Execute Transfer</button>
            <a asp-controller="Account" asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>