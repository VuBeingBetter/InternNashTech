@model Transaction
@{
    var source = ViewBag.FromAccount as BankAccount;
    ViewData["Title"] = "Transfer Funds";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-primary shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Transfer Funds</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Transfer" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="All" class="text-danger"></div>

                        <div class="mb-3">
                            <label class="form-label text-muted">From Account (Source)</label>
                            <input name="fromAccountNumber" value="@(source?.AccountNumber)" class="form-control bg-light" readonly />
                            <div class="form-text text-primary">Current Balance: <strong>@(source?.Balance.ToString("C"))</strong></div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">To Account (Destination)</label>
                            <input id="toAccountInput" name="toAccountNumber" class="form-control" placeholder="Enter account number" required />
                            <div id="receiverNameDisplay" class="form-text text-success fw-bold"></div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Amount</label>
                            <input name="amount" type="number" step="0.01" class="form-control" required />
                        </div>

                        <button type="submit" class="btn btn-primary w-100 mb-2">Execute Transfer</button>
                        <a asp-controller="Account" 
                            asp-action="Details" 
                            asp-route-accountNumber="@(source?.AccountNumber)" 
                            class="btn btn-link w-100">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('toAccountInput').addEventListener('blur', function () {
            const accNum = this.value;
            const display = document.getElementById('receiverNameDisplay');
            
            if (accNum.length > 0) {
                // Fetch owner name from a quick API endpoint
                fetch(`/Account/GetOwnerName?accountNumber=${accNum}`)
                    .then(response => response.json())
                    .then(data => {
                        display.innerText = data.found ? `Recipient: ${data.name}` : "Account not found";
                        display.classList.toggle('text-danger', !data.found);
                        display.classList.toggle('text-success', data.found);
                    });
            }
        });
    </script>
}