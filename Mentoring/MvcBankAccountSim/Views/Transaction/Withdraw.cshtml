@model Transaction
@{ 
    ViewData["Title"] = "Withdraw Money"; 
    var account = ViewBag.Account as BankAccount;   
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-danger shadow">
                <div class="card-header bg-danger text-white"><h3>Withdraw</h3></div>
                <div class="card-body">
                    <form asp-action="Withdraw" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="All" class="text-danger"></div>

                        <div class="mb-3">
                            <label class="form-label">Account Number</label>
                            <input name="accountNumber" 
                                    value="@(account?.AccountNumber ?? Context.Request.Query["accountNumber"])"
                                    class="form-control" readonly />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Amount to Withdraw</label>
                            <input name="amount" type="number" step="0.01" class="form-control" autofocus required />
                            <div class="form-text text-warning">Note: Balance must remain above $100.</div>
                        </div>

                        <button type="submit" class="btn btn-danger w-100">Confirm Withdrawal</button>
                        <a asp-controller="Account" 
                            asp-action="Details" 
                            asp-route-accountNumber="@(account?.AccountNumber ?? Context.Request.Query["accountNumber"])" 
                            class="btn btn-link w-100">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>