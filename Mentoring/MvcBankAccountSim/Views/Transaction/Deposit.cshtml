@model Transaction
@{ ViewData["Title"] = "Deposit Money"; }

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-success shadow">
                <div class="card-header bg-success text-white"><h3>Deposit</h3></div>
                <div class="card-body">
                    <form asp-action="Deposit" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label class="form-label">Account Number</label>
                            <input name="accountNumber" value="@Context.Request.Query["accountNumber"]" class="form-control" readonly />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Amount to Deposit</label>
                            <input name="amount" type="number" step="0.01" class="form-control" autofocus required />
                            <span class="text-danger" asp-validation-for="Amount"></span>
                        </div>

                        <button type="submit" class="btn btn-success w-100">Confirm Deposit</button>
                        <a asp-controller="Account" asp-action="Index" class="btn btn-link w-100">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>