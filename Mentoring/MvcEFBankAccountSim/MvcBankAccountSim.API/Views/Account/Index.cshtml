@model IEnumerable<BankAccount>

<h2>Bank Accounts</h2>
<a asp-action="Create" class="btn btn-primary mb-3">Create New Account</a>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Account Number</th>
            <th>Owner</th>
            <th>Balance</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.AccountNumber</td>
                <td>@item.OwnerName</td>
                <td>@item.Balance.ToString("C")</td>
                <td>
                    <span class="badge @(item.Status == AccountStatus.ACTIVE ? "bg-success" : "bg-danger")">
                        @item.Status
                    </span>
                </td>
                <td>
                    <a asp-action="Details" asp-route-accountNumber="@item.AccountNumber" class="btn btn-sm btn-info">Details</a>
                    
                    <form asp-action="@(item.Status == AccountStatus.ACTIVE ? "Freeze" : "Unfreeze")" 
                          method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="accountNumber" value="@item.AccountNumber" />
                        <button type="submit" class="btn btn-sm @(item.Status == AccountStatus.ACTIVE ? "btn-warning" : "btn-success")">
                            @(item.Status == AccountStatus.ACTIVE ? "Freeze" : "Unfreeze")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>