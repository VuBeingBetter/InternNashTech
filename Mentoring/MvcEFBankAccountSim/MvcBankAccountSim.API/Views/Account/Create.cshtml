@model BankAccount

@{
    ViewData["Title"] = "Create Account";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0">Create New Bank Account</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <!-- Validation Summary for server-side errors (e.g., Unique ID check) -->
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="OwnerName" class="form-label">Owner Full Name</label>
                            <input asp-for="OwnerName" class="form-control" placeholder="John Doe" />
                            <span asp-validation-for="OwnerName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Balance" class="form-label">Initial Balance</label>

                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Balance" type="number" step="0.01" class="form-control" value="0.00" />
                            </div>

                            <span asp-validation-for="Balance" class="text-danger small"></span>
                            
                            <div class="form-text">Note: Minimum balance rule of $100 applies to withdrawals.</div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-circle"></i> Create Account
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
