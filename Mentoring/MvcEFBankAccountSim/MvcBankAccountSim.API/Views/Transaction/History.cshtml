@model IEnumerable<Transaction>
@{
    var account = ViewBag.Account as BankAccount;
    string currentFilter = ViewBag.CurrentFilter ?? "All";
    ViewData["Title"] = "Transaction History";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>History for @account?.AccountNumber</h2>
        <a asp-controller="Account" asp-action="Details" asp-route-accountNumber="@account?.AccountNumber" class="btn btn-outline-secondary">Back to Account</a>
    </div>

    <div class="btn-group mb-4" role="group" aria-label="Transaction Filters">
        <a asp-action="History" asp-route-accountNumber="@account?.AccountNumber" asp-route-filter="All" 
           class="btn @(currentFilter == "All" ? "btn-primary" : "btn-outline-primary")">All</a>
        
        <a asp-action="History" asp-route-accountNumber="@account?.AccountNumber" asp-route-filter="DEPOSIT" 
           class="btn @(currentFilter == "DEPOSIT" ? "btn-primary" : "btn-outline-primary")">Deposits</a>
        
        <a asp-action="History" asp-route-accountNumber="@account?.AccountNumber" asp-route-filter="WITHDRAW" 
           class="btn @(currentFilter == "WITHDRAW" ? "btn-primary" : "btn-outline-primary")">Withdrawals</a>
        
        <a asp-action="History" asp-route-accountNumber="@account?.AccountNumber" asp-route-filter="TRANSFER" 
           class="btn @(currentFilter == "TRANSFER" ? "btn-primary" : "btn-outline-primary")">Transfers</a>
    </div>

    <table class="table table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Amount</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">No @currentFilter.ToLower() transactions found.</td>
                </tr>
            }
            @foreach (var t in Model.OrderByDescending(x => x.CreatedAt))
            {
                // Logic to determine sign based on your preference (Withdraw/Transfer Out = Red)
                bool isNegative = t.Type == TransactionType.WITHDRAW || 
                                (t.Type == TransactionType.TRANSFER && !string.IsNullOrWhiteSpace(t.Description) && t.Description.Contains("to", StringComparison.OrdinalIgnoreCase));
                
                <tr>
                    <td>@t.CreatedAt.ToString("g")</td>
                    <td>
                        <span class="badge @(t.Type == TransactionType.DEPOSIT ? "bg-success" : t.Type == TransactionType.WITHDRAW ? "bg-danger" : "bg-primary")">
                            @t.Type
                        </span>
                    </td>
                    <td class="@(isNegative ? "text-danger" : "text-success") fw-bold">
                        @(isNegative ? "-" : "+")@t.Amount.ToString("C")
                    </td>
                    <td>@t.Description</td>
                </tr>
            }
        </tbody>
    </table>
</div>