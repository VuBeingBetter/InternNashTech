@model IEnumerable<BankAccount>

<h2>Bank Accounts</h2>
<div class="d-flex justify-content-between mb-3">
    <a asp-action="Create" class="btn btn-primary">Create New Account</a>
    
    @* Form tìm kiếm *@
    <form asp-action="Index" method="get" class="d-flex">
        <input type="text" name="search" class="form-control me-2" placeholder="Search by number/owner..." value="@ViewBag.Search" />
        <button type="submit" class="btn btn-outline-primary">Search</button>
    </form>
</div>



<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Account Number</th>
            <th>Owner</th>
            <th>Balance</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.AccountNumber</td>
                <td>@item.OwnerName</td>
                <td>@item.Balance.ToString("C")</td>
                <td>
                    <span class="badge @(item.Status == AccountStatus.ACTIVE ? "bg-success" : "bg-danger")">
                        @item.Status
                    </span>
                </td>
                <td>
                    <a asp-action="Details" asp-route-accountNumber="@item.AccountNumber" class="btn btn-sm btn-info">Details</a>
                    
                    <form asp-action="ToggleStatus" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="accountNumber" value="@item.AccountNumber" />
                        <button type="submit" class="btn btn-sm @(item.Status == AccountStatus.ACTIVE ? "btn-warning" : "btn-success")">
                            @(item.Status == AccountStatus.ACTIVE ? "Freeze" : "Unfreeze")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@* Pagination Bar *@
@if (ViewBag.TotalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination">
            <li class="page-item @(ViewBag.CurrentPage <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" 
                   asp-route-page="@(ViewBag.CurrentPage - 1)" 
                   asp-route-search="@ViewBag.Search">Previous</a>
            </li>

            <li class="page-item active">
                <span class="page-link">Page @ViewBag.CurrentPage of @ViewBag.TotalPages</span>
            </li>

            <li class="page-item @(ViewBag.CurrentPage >= ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" 
                   asp-route-page="@(ViewBag.CurrentPage + 1)" 
                   asp-route-search="@ViewBag.Search">Next</a>
            </li>
        </ul>
    </nav>
}